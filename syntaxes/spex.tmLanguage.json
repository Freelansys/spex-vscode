{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Spex",
  "scopeName": "source.spex",
  "patterns": [
    { "include": "#line-comment" },
    { "include": "#block-comment" },
    { "include": "#brace-product" },
    { "include": "#select-block" },
    { "include": "#fence-python" },
    { "include": "#fence-typescript" },
    { "include": "#fence-javascript" },
    { "include": "#fence-json" },
    { "include": "#fence-shell" },
    { "include": "#fence-sql" },
    { "include": "#fence-go" },
    { "include": "#fence-rust" },
    { "include": "#fence-html" },
    { "include": "#fence-css" },
    { "include": "#fence-yaml" },
    { "include": "#fence-generic" },
    { "include": "#create-declaration" },
    { "include": "#import-declaration" },
    { "include": "#keyword-control" },
    { "include": "#keyword-set-operator" },
    { "include": "#operator" },
    { "include": "#punctuation" },
    { "include": "#string-single" },
    { "include": "#string-double" },
    { "include": "#number" },
    { "include": "#boolean" },
    { "include": "#regexp" },
    { "include": "#base-type" }
  ],
  "repository": {
    "line-comment": {
      "name": "comment.line.double-dash.spex",
      "match": "--.*$"
    },
    "block-comment": {
      "name": "comment.block.spex",
      "begin": "/\\*",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.comment.begin.spex" }
      },
      "end": "\\*/",
      "endCaptures": {
        "0": { "name": "punctuation.definition.comment.end.spex" }
      }
    },
    "string-single": {
      "name": "string.quoted.single.spex",
      "begin": "'",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.spex" }
      },
      "end": "'|$",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.spex" }
      },
      "patterns": [{ "include": "#escape" }]
    },
    "string-double": {
      "name": "string.quoted.double.spex",
      "begin": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.spex" }
      },
      "end": "\"|$",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.spex" }
      },
      "patterns": [{ "include": "#escape" }]
    },
    "escape": {
      "name": "constant.character.escape.spex",
      "match": "\\\\."
    },
    "number": {
      "name": "constant.numeric.spex",
      "match": "\\b\\d+(?:\\.\\d+)?\\b"
    },
    "boolean": {
      "name": "constant.language.boolean.spex",
      "match": "(?i)\\b(?:true|false)\\b"
    },
    "brace-product": {
      "begin": "(?i)(\\bas\\b)([ \\t]*)(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.control.declaration.spex" },
        "3": { "name": "punctuation.definition.bracket.spex" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.bracket.spex" }
      },
      "patterns": [
        { "include": "#brace-nested" },
        { "include": "#keyword-control" },
        { "include": "#keyword-set-operator" },
        { "include": "#base-type" },
        { "include": "#boolean" },
        { "include": "#number" },
        { "include": "#string-single" },
        { "include": "#string-double" },
        { "include": "#operator" },
        { "include": "#punctuation" }
      ]
    },
    "brace-nested": {
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.bracket.spex" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.bracket.spex" }
      },
      "patterns": [
        { "include": "#brace-nested" },
        { "include": "#keyword-control" },
        { "include": "#keyword-set-operator" },
        { "include": "#base-type" },
        { "include": "#boolean" },
        { "include": "#number" },
        { "include": "#string-single" },
        { "include": "#string-double" },
        { "include": "#operator" },
        { "include": "#punctuation" }
      ]
    },
    "select-block": {
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.select.begin.spex" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.select.end.spex" }
      },
      "contentName": "meta.constraint.natural-language.spex",
      "patterns": [
        { "include": "#escape" },
        { "include": "#ref" },
        {
          "match": "^\\s*\\d+\\.",
          "name": "markup.list.numbered.spex"
        },
        {
          "match": "^\\s*-\\s",
          "name": "markup.list.unnumbered.spex"
        }
      ]
    },
    "ref": {
      "name": "variable.other.reference.spex",
      "match": "@[a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*"
    },
    "regexp": {
      "name": "string.regexp.spex",
      "begin": "/",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.spex" }
      },
      "end": "(/)([a-z]*)|$",
      "endCaptures": {
        "1": { "name": "punctuation.definition.string.end.spex" },
        "2": { "name": "keyword.other.regexp.flag.spex" }
      },
      "patterns": [
        { "include": "#escape" },
        { "include": "#regexp-class" }
      ]
    },
    "regexp-class": {
      "begin": "\\[",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.character-class.begin.spex" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation.definition.character-class.end.spex" }
      },
      "patterns": [{ "include": "#escape" }]
    },
    "fence-python": {
      "begin": "(?<![`])(`{3})(?!`)[ \\t]*(?i:(python|py))[ \\t]*$",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.fenced.spex" },
        "2": { "name": "entity.name.language.spex" }
      },
      "end": "```",
      "endCaptures": {
        "0": { "name": "punctuation.definition.fenced.spex" }
      },
      "contentName": "meta.embedded.block.python",
      "patterns": [{ "include": "source.python" }]
    },
    "fence-typescript": {
      "begin": "(?<![`])(`{3})(?!`)[ \\t]*(?i:(typescript|ts))[ \\t]*$",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.fenced.spex" },
        "2": { "name": "entity.name.language.spex" }
      },
      "end": "```",
      "endCaptures": {
        "0": { "name": "punctuation.definition.fenced.spex" }
      },
      "contentName": "meta.embedded.block.typescript",
      "patterns": [{ "include": "source.ts" }]
    },
    "fence-javascript": {
      "begin": "(?<![`])(`{3})(?!`)[ \\t]*(?i:(javascript|js|jsx))[ \\t]*$",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.fenced.spex" },
        "2": { "name": "entity.name.language.spex" }
      },
      "end": "```",
      "endCaptures": {
        "0": { "name": "punctuation.definition.fenced.spex" }
      },
      "contentName": "meta.embedded.block.javascript",
      "patterns": [{ "include": "source.js" }]
    },
    "fence-json": {
      "begin": "(?<![`])(`{3})(?!`)[ \\t]*(?i:(json))[ \\t]*$",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.fenced.spex" },
        "2": { "name": "entity.name.language.spex" }
      },
      "end": "```",
      "endCaptures": {
        "0": { "name": "punctuation.definition.fenced.spex" }
      },
      "contentName": "meta.embedded.block.json",
      "patterns": [{ "include": "source.json" }]
    },
    "fence-shell": {
      "begin": "(?<![`])(`{3})(?!`)[ \\t]*(?i:(bash|sh|shell))[ \\t]*$",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.fenced.spex" },
        "2": { "name": "entity.name.language.spex" }
      },
      "end": "```",
      "endCaptures": {
        "0": { "name": "punctuation.definition.fenced.spex" }
      },
      "contentName": "meta.embedded.block.shellscript",
      "patterns": [{ "include": "source.shell" }]
    },
    "fence-sql": {
      "begin": "(?<![`])(`{3})(?!`)[ \\t]*(?i:(sql))[ \\t]*$",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.fenced.spex" },
        "2": { "name": "entity.name.language.spex" }
      },
      "end": "```",
      "endCaptures": {
        "0": { "name": "punctuation.definition.fenced.spex" }
      },
      "contentName": "meta.embedded.block.sql",
      "patterns": [{ "include": "source.sql" }]
    },
    "fence-go": {
      "begin": "(?<![`])(`{3})(?!`)[ \\t]*(?i:(go))[ \\t]*$",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.fenced.spex" },
        "2": { "name": "entity.name.language.spex" }
      },
      "end": "```",
      "endCaptures": {
        "0": { "name": "punctuation.definition.fenced.spex" }
      },
      "contentName": "meta.embedded.block.go",
      "patterns": [{ "include": "source.go" }]
    },
    "fence-rust": {
      "begin": "(?<![`])(`{3})(?!`)[ \\t]*(?i:(rust))[ \\t]*$",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.fenced.spex" },
        "2": { "name": "entity.name.language.spex" }
      },
      "end": "```",
      "endCaptures": {
        "0": { "name": "punctuation.definition.fenced.spex" }
      },
      "contentName": "meta.embedded.block.rust",
      "patterns": [{ "include": "source.rust" }]
    },
    "fence-html": {
      "begin": "(?<![`])(`{3})(?!`)[ \\t]*(?i:(html))[ \\t]*$",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.fenced.spex" },
        "2": { "name": "entity.name.language.spex" }
      },
      "end": "```",
      "endCaptures": {
        "0": { "name": "punctuation.definition.fenced.spex" }
      },
      "contentName": "meta.embedded.block.html",
      "patterns": [{ "include": "source.html" }]
    },
    "fence-css": {
      "begin": "(?<![`])(`{3})(?!`)[ \\t]*(?i:(css))[ \\t]*$",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.fenced.spex" },
        "2": { "name": "entity.name.language.spex" }
      },
      "end": "```",
      "endCaptures": {
        "0": { "name": "punctuation.definition.fenced.spex" }
      },
      "contentName": "meta.embedded.block.css",
      "patterns": [{ "include": "source.css" }]
    },
    "fence-yaml": {
      "begin": "(?<![`])(`{3})(?!`)[ \\t]*(?i:(yaml|yml))[ \\t]*$",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.fenced.spex" },
        "2": { "name": "entity.name.language.spex" }
      },
      "end": "```",
      "endCaptures": {
        "0": { "name": "punctuation.definition.fenced.spex" }
      },
      "contentName": "meta.embedded.block.yaml",
      "patterns": [{ "include": "source.yaml" }]
    },
    "fence-generic": {
      "begin": "(?<![`])(`{3})(?!`)[ \\t]*([a-zA-Z0-9_]*)[ \\t]*$",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.fenced.spex" },
        "2": { "name": "entity.name.language.spex" }
      },
      "end": "```",
      "endCaptures": {
        "0": { "name": "punctuation.definition.fenced.spex" }
      }
    },
    "create-declaration": {
      "match": "(?i)(\\bcreate\\b)([ \\t]+)(?!(?:create|as|from|select|generate|import|union|intersect|except|realize|in|include|artifact|concept|environment|string|number|bool|unit|true|false)\\b)([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.declaration.spex" },
        "3": { "name": "entity.name.type.spex" }
      }
    },
    "import-declaration": {
      "name": "meta.declaration.import.spex",
      "begin": "(?i)(\\b(?:import|include)\\b)",
      "beginCaptures": {
        "1": { "name": "keyword.control.declaration.spex" }
      },
      "end": ";",
      "endCaptures": {
        "0": { "name": "punctuation.separator.spex" }
      },
      "patterns": [
        { "include": "#string-single" },
        { "include": "#string-double" },
        { "include": "#keyword-control" },
        {
          "match": "[a-zA-Z_][a-zA-Z0-9_]*",
          "name": "entity.name.import.spex"
        }
      ]
    },
    "keyword-control": {
      "name": "keyword.control.declaration.spex",
      "match": "(?i)\\b(?:create|as|from|select|generate|import|realize|include|in)\\b"
    },
    "keyword-set-operator": {
      "name": "keyword.operator.word.spex",
      "match": "(?i)\\b(?:union|intersect|except)\\b"
    },
    "base-type": {
      "name": "storage.type.builtin.spex",
      "match": "(?i)\\b(?:artifact|concept|environment|string|number|bool|unit)\\b"
    },
    "operator": {
      "name": "keyword.operator.spex",
      "match": "->|\\|"
    },
    "punctuation": {
      "patterns": [
        { "match": "[,;:]", "name": "punctuation.separator.spex" },
        { "match": "\\.", "name": "punctuation.accessor.spex" },
        { "match": "[\\(\\)\\[\\]\\{\\}]", "name": "punctuation.definition.bracket.spex" }
      ]
    }
  }
}
