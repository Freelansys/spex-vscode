create TodoConcept as
from concept select {
  Applications to track todo tasks for the user.
  
  It must provide features for adding, listing, removing and completing todo tasks.

  it should persist the todos so that closing the application does not result in the loss of information.
};

create PythonEnv as
from environment select {
  Have a python interpreter installed.
};

create TypescriptEnv as
from environment select {
  Have a node engine installed and compile typescript applications.
};

create Todo as (
  id: string,
  title: string,
  description: string,
  completed: bool,
  createdAt: string
);

create TodoDatabaseConcept as
from concept select {
  A database/module to persist @Todo objects in.

  It should support basic CRUD operations on Todos.
};

create TodoUserInterfaceConcept as
from concept select {
  A user interface that allow user to add, remove, list and complete @Todo objects.
};

realize TodoConcept as {
  database: TodoDatabaseConcept,
  ui: TodoUserInterfaceConcept,
};

create FileDataEnv as
from environment select {
  persists data in files.
};

create ReadTodosFromJsonFile as
from (path: string) -> Todo[] select {
  read the JSON file at &path and return all the todo entiries inside.
};

create InsertTodoIntoJsonFile as
from (path: string, todo: Todo) -> () select {
  append &todo to the JSON file at &path.
};

create UpdateTodoInJsonFile as
from (path: string, todo: Todo) -> () select {
  match &todo with a todo in the JSON file at &path using their ids, and update the todo in the file.
};

create DeleteTodoFromJsonFile as
from (path: string, id: string) -> () select {
  remove the @Todo entry in the JSON file at &path that matches with &id.
};

realize TodoDatabaseConcept as {
  read: ReadTodosFromJsonFile,
  insert: InsertTodoIntoJsonFile,
  update: UpdateTodoInJsonFile,
  delete: DeleteTodoFromJsonFile,
} in FileDataEnv;

create CliEnv as
from environment select {
  environments that interface with the user through terminal.
};

create PrintTodos as from () -> () select {
  get all todos from @TodoDatabaseConcept and print them in console.
};

create SaveTodo as from (todo: Todo) -> () select {
  upsert &todo in @TodoDatabaseConcept.
};

create CreateTodo as from (title: string) -> Todo select {
  1. generate a UUID for the todo id
  2. create a todo with completed set to false
  3. return the created todo
};

create CompleteTodo as from (id: string) -> () select {
  1. find the @Todo in @TodoDatabaseConcept using &id
  2. set its completed to true
  3. save the todo in @TodoDatabaseConcept by calling @SaveTodo
};

create CliCommand as (
  command: string,
  args: string[],
);

create ParseCliArgs as from (args: string[]) -> CliCommand select {
  1. extract the command name from the first element of &args
  2. set the remaining elements of &args as the command arguments
  3. return the command
};

create Main as from string[] -> unit select {
  1. parse process arguments using @ParseCliArgs to get the $command
  2. if &command is "add": call @CreateTodo to create a new todo and then call @SaveTodo to save it
  3. if &command is "list": call @PrintTodos to print the result to stdout
  4. if &command is "complete": call @CompleteTodo to mark the todo as completed
  5. print a help message if &command is invalid
  6. print user-friendly error messages for exceptions
};

realize TodoUserInterfaceConcept as Main in CliEnv;

create TodoCliEnv as
CliEnv intersect FileDataEnv;

generate TodoConcept in PythonEnv intersect TodoCliEnv;
